# ==== dental_demo — PROD env (namuna) ====
# Nusxa oling va HAQIQIY qiymatlar bilan to'ldiring (bu fayl DELPOY.md bo'yicha gitignore'da):
#   cp deploy/.env.prod.example deploy/.env.prod
# Kuchli sir generatsiya: `openssl rand -hex 32`
# DIQQAT: bu fayl HAM backend env_file, HAM compose interpolatsiya/build-arg manbai.
# NEXT_PUBLIC_* va SITE_HTTPS/MEDIA_REWRITE_TARGET o'zgarsa — frontend QAYTA build shart.

# ---- Public origin ----
# Joriy demo: https://dentist.onesystem.uz (umumiy VPS, TLS host nginx + certbot'da).
# Boshqa domen/klinika uchun: pastdagi HAMMA "dentist.onesystem.uz" ni almashtiring.
# TLS'siz IP demo kerak bo'lsa: SITE_HTTPS=false + barcha URL'da http://<IP>.

# ---- nginx port binding ----
# Umumiy server (host nginx :80/:443 ni egallagan, JORIY setup): "127.0.0.1:8090"
# — host nginx TLS'ni tugatib shu portga proxy qiladi (DEPLOY.md 6b).
# Dedicated server (80 bo'sh): "80".
HTTP_BIND=127.0.0.1:8090

# ---- Django ----
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
DEBUG=False
# backend — SSR fetch Host: backend; localhost — healthcheck; domen — ommaviy.
ALLOWED_HOSTS=dentist.onesystem.uz,localhost,127.0.0.1,backend
# true → HSTS + secure-cookie + CSP upgrade-insecure-requests. SECURE_SSL_REDIRECT'ni YOQMAYDI
# (http→https redirect EDGE'da — host nginx/certbot; ADR-022, T-DEPLOY-03 sabog'i).
SITE_HTTPS=true
# Media same-origin → root-relative URL'lar (next/image local optimizatsiya + og metadataBase).
MEDIA_PUBLIC_BASE=/

# ---- Database (parol POSTGRES_PASSWORD bilan BIR XIL bo'lsin) ----
DATABASE_URL=postgres://dental:REPLACE_DB_PASSWORD@db:5432/dental
POSTGRES_DB=dental
POSTGRES_USER=dental
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD

# ---- CORS / CSRF (admin login uchun CSRF_TRUSTED_ORIGINS SHART — sxema bilan) ----
CORS_ALLOWED_ORIGINS=https://dentist.onesystem.uz
CSRF_TRUSTED_ORIGINS=https://dentist.onesystem.uz

# ---- Telegram (SOTILADIGAN xususiyat — klinika xabarnomalari, ADR-010) ----
# @BotFather'dan token, chat_id — klinika guruhi/kanali. Bo'sh bo'lsa xabar yuborilmaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Callback tugmalari (tasdiqlash/bekor) uchun webhook — ixtiyoriy.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://dentist.onesystem.uz

# ---- Booking siyosati (default'lar odatda yetarli) ----
BOOKING_MIN_LEAD_MINUTES=120
BOOKING_WINDOW_DAYS=30
CONSENT_TEXT_VERSION=v1

# ---- ISR purge (reskin/warm) ----
# Backend konteyneridan frontend'ga (reskin ISR'ni tozalaydi).
FRONTEND_BASE_URL=http://frontend:3000
# Frontend runtime ham, backend ham o'qiydi — IKKALA joyda BIR XIL bo'lishi shart.
REVALIDATE_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ---- Frontend build args (client'ga inline; browser shu origin'ga uradi) ----
NEXT_PUBLIC_API_URL=https://dentist.onesystem.uz
NEXT_PUBLIC_MEDIA_URL=https://dentist.onesystem.uz
NEXT_PUBLIC_SITE_URL=https://dentist.onesystem.uz
# Image optimizer media'ni ICHKI nginx orqali oladi (tashqi origin'ga chiqmaydi). Odatda tegilmaydi.
MEDIA_REWRITE_TARGET=http://nginx

# ---- Sentry (ixtiyoriy) ----
SENTRY_DSN=
