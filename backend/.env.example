# ==== dental_demo backend (.env) ====
# Nusxa oling: cp .env.example .env

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (prod: PostgreSQL 17). Boʻsh qoldirilsa dev'da sqlite ishlatiladi.
# DATABASE_URL=postgres://dental:dental@localhost:5432/dental
DATABASE_URL=

# CORS / CSRF (frontend origin — ADR-016)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Telegram (ADR-010)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry (T-P1-70)
SENTRY_DSN=

# Telegram webhook (Faza 2) — bo'sh bo'lsa callback tugmalari ko'rsatilmaydi
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# Booking
BOOKING_MIN_LEAD_MINUTES=120
BOOKING_WINDOW_DAYS=30
CONSENT_TEXT_VERSION=v1
